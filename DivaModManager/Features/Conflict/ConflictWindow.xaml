<Window x:Class="DivaModManager.Features.Conflict.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check mods" Height="720" Width="1100" MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="#202020" FontFamily="{StaticResource DmmFont}">
    <Window.Resources>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="RowBackground" Value="#202020"/>
            <Setter Property="AlternatingRowBackground" Value="#262626"/>
            <Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#303030"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#181818"/>
                        <Setter Property="Foreground" Value="#f2f2f2"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderBrush" Value="#353535"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2f4f4d"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WrapText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SummaryText" Grid.Row="0" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,8,0,6">
            <TextBlock Name="ConflictHeader" Text="Conflicts" Foreground="#3edcd0" FontSize="16" FontWeight="Bold"/>
            <TextBlock Foreground="#b0b0b0" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="When two enabled mods contain the same file, song ID or module ID, only the mod higher in the list is used (Winner). To choose a different winner, move that mod up in the mod list. Song packs that share thumbnail files, or module mods that share an ID, show missing images or costumes in game."/>
        </StackPanel>

        <DataGrid Name="ConflictGrid" Grid.Row="2" Style="{StaticResource GridStyle}" SelectionChanged="ConflictGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="110"/>
                <DataGridTextColumn Header="Conflict" Binding="{Binding Element}" Width="2*"/>
                <DataGridTextColumn Header="Winner (used)" Binding="{Binding Winner}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#3edcd0"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Overridden" Binding="{Binding Overridden}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#ff9a8a"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,14,0,6">
            <TextBlock Name="ProblemHeader" Text="Problems" Foreground="#ffb347" FontSize="16" FontWeight="Bold"/>
            <TextBlock Foreground="#b0b0b0" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Things that can make the game fail or a song not work: mod DLLs that won't load, and song charts, audio or videos that are missing. Errors usually need the mod to be reinstalled or updated."/>
        </StackPanel>

        <DataGrid Name="ProblemGrid" Grid.Row="4" Style="{StaticResource GridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="Foreground" Value="#ff7b72"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="Foreground" Value="#ffb347"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                    <Setter Property="Foreground" Value="#8ab4f8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mod" Binding="{Binding Mod}" Width="180" ElementStyle="{StaticResource WrapText}"/>
                <DataGridTextColumn Header="Problem" Binding="{Binding KindText}" Width="150" ElementStyle="{StaticResource WrapText}"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrapText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="FixButton" Content="Fix thumbnails" Width="150" Height="34" Margin="0,0,10,0" FontSize="16" IsEnabled="False"
                    ToolTip="Move the overridden pack's song thumbnails to their own sprite set so both packs show their thumbnails. Backups are kept."
                    Foreground="#f2f2f2" Background="#181818" BorderBrush="#454545" Click="FixButton_Click"/>
            <Button Name="RescanButton" Content="Scan again" Width="130" Height="34" Margin="0,0,10,0" FontSize="16"
                    Foreground="#f2f2f2" Background="#181818" BorderBrush="#454545" Click="RescanButton_Click"/>
            <Button Content="Close" Width="110" Height="34" FontSize="16" IsCancel="True"
                    Foreground="#f2f2f2" Background="#181818" BorderBrush="#454545" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
