<Window x:Class="DivaModManager.Features.Conflict.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Conflicts" Height="620" Width="1100" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="#202020" FontFamily="{StaticResource DmmFont}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SummaryText" Grid.Row="0" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Foreground="#b0b0b0" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,10"
                   Text="When two enabled mods contain the same file, song ID or module ID, only the mod higher in the list is used (Winner). To choose a different winner, move that mod up in the mod list. Song packs that share thumbnail files, or module mods that share an ID, show missing images or costumes in game."/>

        <DataGrid Name="ConflictGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Background="#181818" Foreground="#f2f2f2" RowBackground="#202020" AlternatingRowBackground="#262626"
                  BorderBrush="#353535" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#303030" FontSize="14"
                  CanUserResizeColumns="True" CanUserSortColumns="True" SelectionMode="Extended">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#181818"/>
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderBrush" Value="#353535"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="4"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2f4f4d"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="110"/>
                <DataGridTextColumn Header="Conflict" Binding="{Binding Element}" Width="2*"/>
                <DataGridTextColumn Header="Winner (used)" Binding="{Binding Winner}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#3edcd0"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Overridden" Binding="{Binding Overridden}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#ff9a8a"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="RescanButton" Content="Scan again" Width="130" Height="34" Margin="0,0,10,0" FontSize="16"
                    Foreground="#f2f2f2" Background="#181818" BorderBrush="#454545" Click="RescanButton_Click"/>
            <Button Content="Close" Width="110" Height="34" FontSize="16" IsCancel="True"
                    Foreground="#f2f2f2" Background="#181818" BorderBrush="#454545" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
